# Anthropic CMA (self-managed environment)
ENVIRONMENT_ID=
ANTHROPIC_ENVIRONMENT_KEY=
WEBHOOK_SECRET=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Islo sandbox API
ISLO_API_KEY=
ISLO_API_BASE_URL=https://api.islo.dev
